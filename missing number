import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr = new int[n - 1];

        for(int i = 0; i < n - 1; i++){
            arr[i] = sc.nextInt();
        }

        for(int i = 1; i <= n; i++){

            boolean found = false;

            for(int j = 0; j < n - 1; j++){

                if(arr[j] == i){
                    found = true;
                    break;
                }
            }

            if(!found){
                System.out.println(i);
            }
        }
    }
}
