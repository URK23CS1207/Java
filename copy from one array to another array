import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr1 = new int[n];
        int[] arr2 = new int[n];


        for(int i = 0; i < n; i++){
            arr1[i] = sc.nextInt();
        }

        for(int i = 0; i < n; i++){
            arr2[i] = arr1[i];
        }
//we can use two for loops to create original and copied array 

        System.out.println("Original Array:");

        for(int i = 0; i < n; i++){
            System.out.print(arr1[i] + " ");
        }

        System.out.println();

        System.out.println("Copied Array:");

        for(int i = 0; i < n; i++){
            System.out.print(arr2[i] + " ");
        }
    }
}
