import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr = new int[n];

        for(int i = 0; i < arr.length; i++){
            arr[i] = sc.nextInt();
        }
        for(int i=0;i<arr.length;i++){
            int count=0;
            boolean visited=false;
            for(int k=0;k<i;k++){
                if(arr[i]==arr[k]){
                    visited=true;
                    break;
                }
                
            }
            if(visited){
                continue;
            }
            for(int j=0;j<n;j++){
                if(arr[i]==arr[j]){
                    count++;
                }
                
            }
            System.out.println(arr[i]+ "->" +count);

        }
        
    }
}
