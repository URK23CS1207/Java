import java.util.Scanner;
import java.util.Arrays;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr = new int[n];
        

        for(int i = 0; i < arr.length; i++){
            arr[i] = sc.nextInt();
        }
        int count=0;

        for(int i =0;i<arr.length;i++){
            if(arr[i] % 2 != 0){
                count++;
                
            }
            
        }
        System.out.println(count);

        
    }
}
